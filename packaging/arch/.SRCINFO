pkgbase = tracepad
	pkgdesc = Use o iPhone como trackpad do computador (host Linux: USB, Wi-Fi e Bluetooth)
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/joaodobread/ios-trackpad
	install = tracepad.install
	arch = any
	license = MIT
	depends = python
	depends = python-evdev
	depends = python-psutil
	depends = usbmuxd
	depends = libimobiledevice
	optdepends = python-bleak: conexão por Bluetooth (BLE)
	optdepends = libpulse: controle de volume (pactl)
	optdepends = brightnessctl: controle de brilho da tela
	optdepends = wtype: digitar texto no Wayland
	optdepends = wl-clipboard: colar texto no Wayland
	optdepends = playerctl: controle de mídia (tocar/pausar, próxima faixa)
	optdepends = xclip: área de transferência no X11
	optdepends = wmctrl: listar e focar janelas no X11
	optdepends = xdotool: digitar texto e focar janelas no X11
	optdepends = qrencode: mostrar o QR code do PWA nos logs
	source = tracepad-1.0.0.tar.gz::https://github.com/joaodobread/ios-trackpad/archive/refs/tags/v1.0.0.tar.gz
	source = tracepad.sh
	source = tracepad.service
	source = 60-tracepad-uinput.rules
	source = tracepad-uinput.conf
	sha256sums = SKIP
	sha256sums = 63dbfdfa6e6a44abd00a634a0741ba0064d65f2c531f74efd7acaebf7aee492f
	sha256sums = 7828045ab52285e0be11ebc0cf31f0e5daa4c05d82f9d8e8d541706711a9ccf4
	sha256sums = 27e69cdde6bcbb696b345efc7646c9be04357243dd8afa3f0a5c521d5cd87b1b
